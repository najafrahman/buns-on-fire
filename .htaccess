# ══════════════════════════════════════════
#  Buns on Fire — Security Configuration
# ══════════════════════════════════════════

# ── HTTPS Redirect ─────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Security Headers ───────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # XSS protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy — disable unused APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HSTS — force HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://fonts.googleapis.com https://i.postimg.cc; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.postimg.cc https://www.google-analytics.com; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://formspree.io; frame-ancestors 'self';"

  # Remove server signature
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ── Disable Directory Listing ──────────────
Options -Indexes

# ── Block Access to Sensitive Files ────────
<FilesMatch "(^\.git|\.env|\.gitignore|\.htpasswd|composer\.json|package\.json|\.cpanel\.yml|\.netlifyignore|netlify\.toml)">
  Order allow,deny
  Deny from all
</FilesMatch>

# ── Protect deploy.php — only GitHub IPs ──
# GitHub webhook IPs (hooks.github.com range)
<Files "deploy.php">
  Order Deny,Allow
  Deny from all
  # GitHub Meta API IPs for webhooks
  Allow from 140.82.112.0/20
  Allow from 185.199.108.0/22
  Allow from 192.30.252.0/22
  Allow from 143.55.64.0/20
</Files>

# ── Block Common Attack Patterns ───────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block SQL injection attempts
  RewriteCond %{QUERY_STRING} (union|select|insert|drop|delete|update|cast|create|char|convert|alter|declare|script|set|md5|benchmark) [NC]
  RewriteRule .* - [F,L]

  # Block XSS attempts in query strings
  RewriteCond %{QUERY_STRING} (<|>|%3C|%3E) [NC]
  RewriteRule .* - [F,L]

  # Block shell injection
  RewriteCond %{QUERY_STRING} (;|%3B).*(exec|system|passthru|popen|proc_open|shell_exec) [NC]
  RewriteRule .* - [F,L]

  # Block suspicious user agents (bots/scanners)
  RewriteCond %{HTTP_USER_AGENT} (havij|sqlmap|nikto|nessus|masscan|nmap|zgrab) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (python-requests|go-http-client|curl) [NC]
  RewriteRule .* - [F,L]

  # Block access to hidden files/folders
  RewriteCond %{REQUEST_URI} /\. [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ── Limit Request Size ──────────────────────
LimitRequestBody 10485760

# ── Browser Caching ────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# ── Gzip Compression ───────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>
